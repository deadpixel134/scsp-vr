<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>SongPrismVR.RuntimeBootstrap</AssemblyName>
    <Version>0.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SongPrismVR.Core\SongPrismVR.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="D3D11DeviceCapture.cs" />
    <Compile Remove="D3D11Interop.cs" />
    <Compile Remove="D3D11VerticalBlitter.cs" />
    <Compile Remove="OpenXrProbe.cs" />
  </ItemGroup>
</Project>
